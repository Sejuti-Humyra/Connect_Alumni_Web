@model List<MVC_CRUD.Models.Post>

@{
    ViewData["Title"] = "News Feed";

    int currentUserId = ViewBag.CurrentUserId ?? 0;
    int newPostId = TempData["NewPostId"] != null ? (int)TempData["NewPostId"] : 0;
}

<style>
    @@keyframes postHighlight {
        0% {
            box-shadow: 0 0 0 3px #22c55e55, 0 4px 24px #22c55e22;
            background: #f0fdf4;
        }

        60% {
            box-shadow: 0 0 0 2px #22c55e33, 0 4px 16px #22c55e11;
            background: #f0fdf4;
        }

        100% {
            box-shadow: none;
            background: white;
        }
    }

    .new-post-card {
        animation: postHighlight 2.8s ease-out forwards;
    }

    @@keyframes badgePop {
        0% {
            transform: scale(0.6);
            opacity: 0;
        }

        60% {
            transform: scale(1.15);
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .new-post-badge {
        animation: badgePop 0.5s cubic-bezier(.34,1.56,.64,1) forwards;
    }
</style>

<div class="max-w-2xl mx-auto px-4 py-8">

    <!-- ================= CREATE POST ================= -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5 mb-6">

        <div class="flex gap-3">

            <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center">
                @ViewBag.UserName?.ToString().Substring(0, 1).ToUpper()
            </div>

            <form asp-action="Create" method="post" class="flex-1">
                @Html.AntiForgeryToken()

                <textarea name="content" rows="3"
                          placeholder="Share something with your network..."
                          class="w-full bg-slate-50 rounded-2xl px-4 py-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 border"></textarea>

                <div class="flex justify-end mt-2">
                    <button type="submit"
                            class="bg-blue-600 hover:bg-blue-700 text-white text-sm px-5 py-2.5 rounded-xl">
                        Post
                    </button>
                </div>

            </form>

        </div>

    </div>

    <!-- ================= FEED ================= -->
    @if (!Model.Any())
    {
        <div class="text-center py-16 text-slate-400">
            <p>No posts yet.</p>
        </div>
    }

    @foreach (var post in Model)
    {
        bool userLiked = post.Likes.Any(l => l.UserId == currentUserId);
        bool isOwner = post.UserId == currentUserId;
        bool isAdmin = ViewBag.UserRole == "Admin";
        bool isNew = post.Id == newPostId;

        <div id="post-@post.Id"
             class="bg-white rounded-3xl border shadow-sm mb-5 @(isNew ? "new-post-card" : "")">

            <div class="p-5">

                <!-- ================= HEADER ================= -->
                <div class="flex justify-between mb-4">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center">
                            @post.User?.FullName?.Substring(0, 1).ToUpper()
                        </div>

                        <div>
                            <p class="font-semibold text-sm">@post.User?.FullName</p>

                            @if (isNew)
                            {
                                <span class="new-post-badge text-xs bg-green-100 text-green-600 px-2 py-0.5 rounded-full">
                                    Just posted
                                </span>
                            }

                            <p class="text-xs text-slate-400">
                                @post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")
                            </p>
                        </div>

                    </div>

                    <!-- ================= DELETE ================= -->
                    @if (isOwner || isAdmin)
                    {
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@post.Id" />

                            <button type="submit"
                                    onclick="return confirm('Delete this post?')"
                                    class="text-slate-400 hover:text-red-500">
                                🗑
                            </button>
                        </form>
                    }

                </div>

                <!-- ================= CONTENT ================= -->
                <p class="text-sm mb-4">@post.Content</p>

                <!-- ================= LIKE / COMMENT COUNT ================= -->
                <div class="text-xs text-slate-400 flex gap-4 border-b pb-2">
                    <span>@post.Likes.Count Likes</span>
                    <span>@post.Comments.Count Comments</span>
                </div>

                <!-- ================= ACTIONS ================= -->
                <div class="flex gap-2 mt-3">

                    <form asp-action="ToggleLike" method="post">
                        <input type="hidden" name="postId" value="@post.Id" />

                        <button class="text-xs px-3 py-1 rounded
                                @(userLiked ? "bg-red-100 text-red-500" : "bg-slate-100")">

                            @(userLiked ? "Liked" : "Like")

                        </button>
                    </form>

                    <button onclick="toggleComment(@post.Id)"
                            class="text-xs px-3 py-1 bg-slate-100 rounded">
                        Comment
                    </button>

                </div>

                <!-- ================= COMMENTS ================= -->
                @if (post.Comments.Any())
                {
                    <div class="mt-4 space-y-2">

                        @foreach (var comment in post.Comments)
                        {
                            <div class="text-xs bg-slate-50 p-2 rounded">

                                <b>@comment.User?.FullName</b>:
                                @comment.Content

                            </div>
                        }

                    </div>
                }

                <!-- ================= COMMENT BOX ================= -->
                <div id="comment-box-@post.Id" class="hidden mt-3">

                    <form asp-action="AddComment" method="post">

                        <input type="hidden" name="postId" value="@post.Id" />

                        <div class="flex gap-2">

                            <input type="text"
                                   name="content"
                                   class="flex-1 border rounded px-3 py-1 text-xs"
                                   placeholder="Write comment..." />

                            <button class="bg-blue-600 text-white px-3 py-1 text-xs rounded">
                                Send
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        function toggleComment(id) {
            document.getElementById('comment-box-' + id)
                .classList.toggle('hidden');
        }
    </script>
}