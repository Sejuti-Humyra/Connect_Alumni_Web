@model MVC_CRUD.ViewModels.AdminDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Admin Dashboard";

    string displayName =
        User?.Identity?.Name ??
        Context.Session.GetString("UserName") ??
        "Admin";
}

<div class="max-w-7xl mx-auto px-4 py-10">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->
    <div class="flex items-center justify-between mb-6">

        <div>
            <h1 class="text-2xl font-bold">
                Admin Dashboard
            </h1>

            <p class="text-sm text-gray-500">
                Overview and quick actions
            </p>
        </div>

        <div class="text-sm text-gray-500">
            Welcome back,
            <strong class="text-slate-800">
                @displayName
            </strong>
        </div>

    </div>

    <!-- ========================================= -->
    <!-- STATS -->
    <!-- ========================================= -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

        <!-- Total Jobs -->
        <div class="bg-white p-5 rounded-lg shadow-sm border">

            <p class="text-sm text-gray-500">
                Total Jobs
            </p>

            <p class="text-3xl font-semibold mt-2">
                @Model.TotalJobs
            </p>

            <p class="text-xs text-gray-400 mt-2">
                All-time job posts
            </p>

        </div>

        <!-- Total Users -->
        <div class="bg-white p-5 rounded-lg shadow-sm border">

            <p class="text-sm text-gray-500">
                Total Users
            </p>

            <p class="text-3xl font-semibold mt-2">
                @Model.TotalUsers
            </p>

            <p class="text-xs text-gray-400 mt-2">
                Registered accounts
            </p>

        </div>

        <!-- Jobs Today -->
        <div class="bg-white p-5 rounded-lg shadow-sm border">

            <p class="text-sm text-gray-500">
                Jobs Today
            </p>

            <p class="text-3xl font-semibold mt-2">
                @Model.JobsToday
            </p>

            <p class="text-xs text-gray-400 mt-2">
                Posted since midnight (UTC)
            </p>

        </div>

        <!-- Refresh -->
        <div class="bg-white p-5 rounded-lg shadow-sm border flex items-center justify-between">

            <div>
                <p class="text-sm text-gray-500">
                    Recent Jobs
                </p>

                <p class="text-3xl font-semibold mt-2">
                    @Model.RecentJobs.Count
                </p>

                <p class="text-xs text-gray-400 mt-2">
                    Latest entries
                </p>
            </div>

            <div class="text-right">
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="inline-block bg-blue-600 text-white px-3 py-2 rounded-lg text-sm hover:bg-blue-700">

                    Refresh

                </a>
            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- CHARTS -->
    <!-- ========================================= -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

        <!-- Line Chart -->
        <div class="lg:col-span-2 bg-white p-5 rounded-lg shadow-sm border">

            <h2 class="font-semibold mb-3">
                Jobs Posted — Last 7 days
            </h2>

            <canvas id="jobsLineChart" height="160"></canvas>

            <p class="text-xs text-gray-400 mt-3">
                Daily job posts (most recent last).
            </p>

        </div>

        <!-- Donut Chart -->
        <div class="bg-white p-5 rounded-lg shadow-sm border">

            <h2 class="font-semibold mb-3">
                Jobs by Type
            </h2>

            <canvas id="jobsDonutChart" height="200"></canvas>

            <p class="text-xs text-gray-400 mt-3">
                Distribution across job types.
            </p>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- RECENT JOBS -->
    <!-- ========================================= -->
    <div class="bg-white p-5 rounded-lg shadow-sm border mb-8">

        <div class="flex items-center justify-between mb-4">

            <h2 class="font-semibold text-lg">
                Recent Jobs
            </h2>

            <a asp-controller="Jobs"
               asp-action="Index"
               class="text-sm text-blue-600 hover:underline">

                View all jobs

            </a>

        </div>

        @if (!Model.RecentJobs.Any())
        {
            <p class="text-gray-500">
                No recent jobs found.
            </p>
        }
        else
        {
            <div class="overflow-x-auto">

                <table class="w-full text-sm">

                    <thead class="text-left text-gray-600">

                        <tr>
                            <th class="p-2">Title</th>
                            <th class="p-2">Company</th>
                            <th class="p-2">Type</th>
                            <th class="p-2">Posted</th>
                            <th class="p-2">Posted By</th>
                            <th class="p-2 text-right">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var job in Model.RecentJobs)
                        {
                            <tr class="border-t">

                                <td class="p-2 font-medium">
                                    @job.Title
                                </td>

                                <td class="p-2 text-gray-600">
                                    @job.Company
                                </td>

                                <td class="p-2">
                                    @job.Type
                                </td>

                                <td class="p-2 text-gray-500">
                                    @job.PostedAt.ToString("dd MMM yyyy")
                                </td>

                                <td class="p-2 text-gray-600">
                                    @job.PostedBy?.FullName
                                </td>

                                <td class="p-2 text-right">

                                    <!-- VIEW -->
                                    <a asp-controller="Jobs"
                                       asp-action="Details"
                                       asp-route-id="@job.Id"
                                       class="text-blue-600 mr-3 hover:underline">

                                        View

                                    </a>

                                    <!-- DELETE -->
                                    <a asp-controller="Admin"
                                       asp-action="DeleteJob"
                                       asp-route-id="@job.Id"
                                       class="text-red-600 hover:underline">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <!-- ========================================= -->
    <!-- RECENT USERS -->
    <!-- ========================================= -->
    <div class="bg-white p-5 rounded-lg shadow-sm border">

        <div class="flex items-center justify-between mb-4">

            <h2 class="font-semibold text-lg">
                Recent Users
            </h2>

        </div>

        @if (!Model.RecentUsers.Any())
        {
            <p class="text-gray-500">
                No recent users.
            </p>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">

                @foreach (var u in Model.RecentUsers)
                {
                    <div class="p-3 rounded-lg border bg-gray-50">

                        <div class="flex items-center justify-between">

                            <!-- USER INFO -->
                            <div class="flex items-center gap-3">

                                <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold">

                                    @u.FullName?.Substring(0, 1).ToUpper()

                                </div>

                                <div>

                                    <div class="font-medium">
                                        @u.FullName
                                    </div>

                                    <div class="text-xs text-gray-500">
                                        @u.Email
                                    </div>

                                </div>

                            </div>

                            <!-- VIEW USER -->
                            <a asp-controller="Alumni"
                               asp-action="Details"
                               asp-route-id="@u.Id"
                               class="text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">

                                View

                            </a>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        // =========================================
        // CHART DATA
        // =========================================
        const last7Labels =
            @Html.Raw(JsonSerializer.Serialize(Model.Last7Labels));

        const last7Data =
            @Html.Raw(JsonSerializer.Serialize(Model.Last7Data));

        const typeLabels =
            @Html.Raw(JsonSerializer.Serialize(Model.JobTypeLabels));

        const typeData =
            @Html.Raw(JsonSerializer.Serialize(Model.JobTypeData));

        // =========================================
        // LINE CHART
        // =========================================
        const ctxLine =
            document.getElementById('jobsLineChart').getContext('2d');

        new Chart(ctxLine, {

            type: 'line',

            data: {

                labels: last7Labels,

                datasets: [{
                    label: 'Jobs',
                    data: last7Data,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,0.08)',
                    pointBackgroundColor: '#fff',
                    tension: 0.35,
                    fill: true
                }]
            },

            options: {

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {

                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });

        // =========================================
        // DONUT CHART
        // =========================================
        const ctxDonut =
            document.getElementById('jobsDonutChart').getContext('2d');

        new Chart(ctxDonut, {

            type: 'doughnut',

            data: {

                labels: typeLabels,

                datasets: [{
                    data: typeData,

                    backgroundColor: [
                        '#2563eb',
                        '#06b6d4',
                        '#f59e0b',
                        '#ef4444',
                        '#10b981'
                    ],

                    hoverOffset: 6
                }]
            },

            options: {

                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

    </script>
}