@model MVC_CRUD.Models.Job

@{
    ViewData["Title"] = "Delete Job";
}

<div class="max-w-2xl mx-auto px-4 py-10">

    <div class="bg-white border shadow-sm rounded-2xl p-6">

        <h1 class="text-2xl font-bold text-red-600 mb-4">
            Delete Job
        </h1>

        <p class="text-slate-600 mb-6">
            Are you sure you want to delete this job?
        </p>

        <div class="border rounded-xl p-4 bg-slate-50">

            <h2 class="text-xl font-semibold text-slate-900">
                @Model.Title
            </h2>

            <p class="text-slate-500 mt-1">
                @Model.Company
            </p>

            <div class="mt-3 text-sm text-slate-600">
                <p><strong>Type:</strong> @Model.Type</p>
                <p><strong>Location:</strong> @Model.Location</p>
                <p><strong>Posted By:</strong> @Model.PostedBy?.FullName</p>
                <p><strong>Date:</strong> @Model.PostedAt.ToString("dd MMM yyyy")</p>
            </div>

        </div>

        <form asp-controller="Admin"
              asp-action="ConfirmDeleteJob"
              method="post"
              class="mt-6">

            <input type="hidden" asp-for="Id" />

            <div class="flex gap-3">

                <button type="submit"
                        class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg">
                    Delete Permanently
                </button>

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-5 py-2 rounded-lg">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>