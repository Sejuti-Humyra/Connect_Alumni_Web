@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-lg mx-auto px-4 py-10">
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">

        <h2 class="font-display font-bold text-xl text-slate-900 mb-6 flex items-center gap-2">
            <i class="bi bi-lock text-primary-600"></i> Change Password
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl px-4 py-3 mb-6">
                <i class="bi bi-exclamation-circle-fill"></i> @ViewBag.Error
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="space-y-5">

            @foreach (var field in new[] {
                        ("currentPassword", "Current Password",  "cur",  "curEye"),
                        ("newPassword",     "New Password",      "newp", "newEye"),
                        ("confirmPassword", "Confirm Password",  "conf", "conEye")
                        })
            {
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">@field.Item2</label>
                    <div class="relative">
                        <i class="bi bi-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" name="@field.Item1" id="@field.Item3" required
                               placeholder="@field.Item2"
                               class="w-full pl-10 pr-11 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all" />
                        <button type="button" onclick="togglePwd('@field.Item3','@field.Item4')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                            <i id="@field.Item4" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 rounded-2xl text-sm transition-all">
                    Update Password
                </button>
                <a asp-controller="User" asp-action="Profile"
                   class="flex-1 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 rounded-2xl text-sm transition-all no-underline">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePwd(inputId, iconId) {
            const i = document.getElementById(inputId);
            const ic = document.getElementById(iconId);
            i.type = i.type === 'password' ? 'text' : 'password';
            ic.className = i.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
}