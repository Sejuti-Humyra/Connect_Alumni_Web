@model MVC_CRUD.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="max-w-2xl mx-auto px-4 py-10">

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-2xl px-4 py-3 mb-6">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">

        <!-- Header -->
        <div class="bg-blue-600 px-8 py-10 text-center">
            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
                <span class="text-3xl font-bold text-blue-600">
                    @Model.FullName?.Substring(0, 1).ToUpper()
                </span>
            </div>

            <h2 class="text-2xl font-bold text-white">
                @Model.FullName
            </h2>

            <span class="inline-block mt-2 bg-white/20 text-white text-xs font-semibold px-4 py-1.5 rounded-full">
                @Model.Role
            </span>
        </div>

        <!-- Details -->
        <div class="px-8 py-8 bg-slate-50">

            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-5 border-b pb-3">
                Account Details
            </h3>

            <div class="space-y-4">

                <!-- Name -->
                <div class="flex items-center gap-4 py-3 border-b border-slate-200">
                    <div class="w-9 h-9 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="bi bi-person text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400">Full Name</p>
                        <p class="text-sm font-semibold text-slate-800">@Model.FullName</p>
                    </div>
                </div>

                <!-- Email -->
                <div class="flex items-center gap-4 py-3 border-b border-slate-200">
                    <div class="w-9 h-9 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="bi bi-envelope text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400">Email</p>
                        <p class="text-sm font-semibold text-slate-800">@Model.Email</p>
                    </div>
                </div>

                <!-- Role -->
                <div class="flex items-center gap-4 py-3 border-b border-slate-200">
                    <div class="w-9 h-9 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="bi bi-shield-check text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400">Role</p>
                        <span class="inline-block text-xs font-semibold bg-blue-50 text-blue-600 px-3 py-1 rounded-full mt-1">
                            @Model.Role
                        </span>
                    </div>
                </div>

                <!-- Created -->
                <div class="flex items-center gap-4 py-3">
                    <div class="w-9 h-9 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="bi bi-calendar text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400">Member Since</p>
                        <p class="text-sm font-semibold text-slate-800">
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>

            </div>

            <!-- Buttons -->
            <div class="flex gap-3 mt-8">

                <a asp-controller="User" asp-action="EditProfile"
                   class="flex-1 flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm py-3 rounded-2xl transition-all no-underline">
                    <i class="bi bi-pencil-square"></i> Edit Profile
                </a>

                <a asp-controller="User" asp-action="ChangePassword"
                   class="flex-1 flex items-center justify-center gap-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold text-sm py-3 rounded-2xl transition-all no-underline">
                    <i class="bi bi-lock"></i> Change Password
                </a>

            </div>

        </div>
    </div>
</div>