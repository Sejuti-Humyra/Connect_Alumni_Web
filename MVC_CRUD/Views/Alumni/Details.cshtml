@model MVC_CRUD.Models.User

@{
    ViewData["Title"] = "Profile";
}

<div class="max-w-4xl mx-auto px-4 py-10">

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">

        <!-- Top Banner -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 h-32 relative">
            <div class="absolute -bottom-12 left-8">
                <div class="w-24 h-24 rounded-full bg-white shadow-lg flex items-center justify-center border-4 border-white">
                    <span class="text-3xl font-bold text-blue-600">
                        @Model.FullName?.Substring(0, 1).ToUpper()
                    </span>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="pt-16 px-8 pb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">@Model.FullName</h2>
                    <span class="inline-block mt-2 bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-sm font-semibold">
                        @Model.Role
                    </span>
                </div>

                <a href="@Url.Action("Conversation", "Messages", new { id = Model.Id })"
                   class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl text-sm no-underline">
                    <i class="bi bi-chat-dots"></i> Message
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">

                <div>
                    <p class="text-sm text-slate-400">Email</p>
                    <p class="font-medium text-slate-800">@Model.Email</p>
                </div>
                <div>
                    <p class="text-sm text-slate-400">Joined</p>
                    <p class="font-medium text-slate-800">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>

            </div>
        </div>
    </div>

</div>